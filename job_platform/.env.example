# --- LLM provider ---------------------------------------------------------
# Which provider the scorer and resume tailor use: "anthropic" or "gemini"
LLM_PROVIDER=anthropic

# Anthropic (https://platform.claude.com) — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model for the two-pass scorer and resume tailoring. claude-opus-4-8 is the
# recommended default; override if you want a different model.
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini — used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Pipeline toggles (can also be set in config/candidate_profile.yaml) ---
# Hard cap on LLM-scored listings per run (safety valve against cost spikes
# on the very first run, when everything is NEW). 0 = unlimited.
MAX_SCORED_PER_RUN=0
